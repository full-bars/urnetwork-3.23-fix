      "description": "Targets whose last scrape failed. Check the node is running and `urnet-tools metrics status` shows this address.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(up{job=\"urnetwork\", instance=~\"$instance\"} == 0) or vector(0)",
