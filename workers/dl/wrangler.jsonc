    { "pattern": "dl.fullbars.xyz/uninstall.sh", "zone_name": "fullbars.xyz" },
    { "pattern": "dl.fullbars.xyz/uninstall-win.ps1", "zone_name": "fullbars.xyz" },
    { "pattern": "install.fullbars.xyz/*", "zone_name": "fullbars.xyz" }
  ]
}
